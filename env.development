# Configurações para ambiente de desenvolvimento
APP_ENV=development
APP_PORT=8080
JAVA_OPTS=-Xmx256m -Xms128m -Dspring.profiles.active=dev

# Banco de dados
POSTGRES_DB=fintech_dev
POSTGRES_USER=fintech_user
POSTGRES_PASSWORD=dev_password
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Nginx
NGINX_PORT=80
NGINX_SSL_PORT=443

# Logs
LOG_LEVEL=DEBUG
