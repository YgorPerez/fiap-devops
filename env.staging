# Configurações para ambiente de staging
APP_ENV=staging
APP_PORT=8080
JAVA_OPTS=-Xmx512m -Xms256m -Dspring.profiles.active=staging

# Banco de dados
POSTGRES_DB=fintech_staging
POSTGRES_USER=fintech_user
POSTGRES_PASSWORD=staging_password_secure
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Nginx
NGINX_PORT=80
NGINX_SSL_PORT=443

# Logs
LOG_LEVEL=INFO
