# Configurações para ambiente de produção
APP_ENV=production
APP_PORT=8080
JAVA_OPTS=-Xmx1024m -Xms512m -Dspring.profiles.active=prod

# Banco de dados
POSTGRES_DB=fintech_prod
POSTGRES_USER=fintech_user
POSTGRES_PASSWORD=production_password_very_secure
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Nginx
NGINX_PORT=80
NGINX_SSL_PORT=443

# Logs
LOG_LEVEL=WARN
